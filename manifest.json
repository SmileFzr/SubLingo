{
  "manifest_version": 3,
  "name": "SubLingo · 双语字幕",
  "version": "3.0.0",
  "description": "为 YouTube、Bilibili、Twitch、Kick、TikTok 等视频网站提供实时双语字幕：支持拖拽定位、样式预设、本地 SRT/VTT 对齐与字幕导出。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.bilibili.com/*",
    "*://*.twitch.tv/*",
    "*://*.kick.com/*",
    "*://*.tiktok.com/*",
    "*://*.vimeo.com/*",
    "*://*.dailymotion.com/*",
    "*://*.nicovideo.jp/*",
    "*://*.iqiyi.com/*",
    "*://*.youku.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.coursera.org/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubLingo 双语字幕",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.bilibili.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.tiktok.com/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.nicovideo.jp/*",
        "*://*.iqiyi.com/*",
        "*://*.youku.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.coursera.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
