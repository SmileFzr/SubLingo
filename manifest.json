{
  "manifest_version": 3,
  "name": "SubLingo · 双语字幕",
  "version": "3.6.0",
  "description": "为 YouTube、Bilibili、Twitch、Kick、TikTok 等视频网站提供实时双语字幕：站内 CC、本地 SRT/VTT，以及无字幕视频的本地 AI 语音识别。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "offscreen",
    "tabCapture"
  ],
  "optional_permissions": [],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.bilibili.com/*",
    "*://*.twitch.tv/*",
    "*://*.kick.com/*",
    "*://*.tiktok.com/*",
    "*://*.vimeo.com/*",
    "*://*.dailymotion.com/*",
    "*://*.nicovideo.jp/*",
    "*://*.iqiyi.com/*",
    "*://*.youku.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.coursera.org/*",
    "*://hf-mirror.com/*",
    "*://*.huggingface.co/*",
    "*://*.hf.co/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "打开 SubLingo 双语字幕面板"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubLingo 双语字幕",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.bilibili.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.tiktok.com/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.nicovideo.jp/*",
        "*://*.iqiyi.com/*",
        "*://*.youku.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}